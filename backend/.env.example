PORT=5000
# Kết nối mặc định vào MongoDB của Docker:
# - Khi chạy trong Docker: kết nối thẳng tới container `mongodb:27017` (Replica Set `rs0`)
# - Khi chạy ngoài Windows (`npm run dev` / `npm start`): tự động ánh xạ sang `127.0.0.1:27019` của container `school-mongodb`
MONGODB_URI=mongodb://mongodb:27017/school_management?replicaSet=rs0
DOCKER_MONGO_HOST_PORT=27019
ALLOW_STANDALONE_MONGODB=true
TRUST_PROXY=1
SAAS_MODE=phase1e
SCHOOL_TIMEZONE=Asia/Ho_Chi_Minh

JWT_SECRET=school-management-default-jwt-secret-key-2026-min-32-chars
JWT_EXPIRES_IN=8h
JWT_ISSUER=school-management-api
JWT_AUDIENCE=school-management-web
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# Tự động đồng bộ Multi-Tenant Indexes và tạo tài khoản admin mặc định (admin / 123456) nếu DB chưa có admin
RUN_DB_BOOTSTRAP=true
ENSURE_SAAS_INDEXES=true
AUTO_CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456
DEFAULT_SCHOOL_CODE=HOANANG-A
DEFAULT_SCHOOL_NAME=Trường Mầm non Hoa Nắng - Cơ sở A
AUTO_SEED_ON_EMPTY_DB=false
DEMO_SEED_PASSWORD=123456

ATTENDANCE_DUPLICATE_TOLERANCE_MS=120000
DEVICE_INGEST_API_KEY=school-device-ingest-default-secret-2026
BACKGROUND_REMINDERS_ENABLED=false
TIMEKEEPING_SCHEDULER_ENABLED=false

# ============================================================================
# HIKVISION TIMEKEEPING INTEGRATION (ISAPI)
# Chú ý: TUYỆT ĐỐI KHÔNG cấu hình hoặc truy cập IP 192.168.1.22
# ============================================================================
HIKVISION_SYNC_ENABLED=false
HIKVISION_HOANANG_A_BASE_URL=https://192.168.1.8
HIKVISION_HOANANG_A_USERNAME=admin
HIKVISION_HOANANG_A_PASSWORD=replace-with-device-password
HIKVISION_HOANANG_A_ALLOW_SELF_SIGNED=true
HIKVISION_TIMEOUT_MS=5000
HIKVISION_RETRY_COUNT=1
TIMEKEEPING_WEBHOOK_TOKEN=
