# ============================================================================
# CẤU HÌNH DOCKER COMPOSE — SCHOOL MANAGEMENT SYSTEM (SAAS MULTI-TENANT)
# Sao chép tệp này thành `.env` ở thư mục gốc trước khi chạy `docker compose up -d`
# ============================================================================

# --- Cổng mở ra máy chủ (Host Ports) ---
FRONTEND_PORT=5173
BACKEND_PORT=5000
MONGO_BIND_IP=127.0.0.1
MONGO_PORT=27017

# --- Chế độ vận hành Backend & Database ---
SAAS_MODE=phase1e
SCHOOL_TIMEZONE=Asia/Ho_Chi_Minh
ALLOW_STANDALONE_MONGODB=true
TRUST_PROXY=1

# Tự động đồng bộ 23 nhóm Multi-Tenant Compound Indexes và tự động tạo tài khoản
# quản trị mặc định (admin / 123456) nếu trong DB chưa có tài khoản admin nào
RUN_DB_BOOTSTRAP=true
ENSURE_SAAS_INDEXES=true
AUTO_CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456
DEFAULT_SCHOOL_CODE=HOANANG-A
DEFAULT_SCHOOL_NAME=Trường Mầm non Hoa Nắng - Cơ sở A

# Bật thành `true` nếu muốn nạp thêm toàn bộ dữ liệu giả lập mẫu (học sinh, lớp, thực đơn, hóa đơn) khi DB trống
AUTO_SEED_ON_EMPTY_DB=false
DEMO_SEED_PASSWORD=123456

# --- Bảo mật JWT & Platform MFA (HÃY ĐỔI KHI TRIỂN KHAI PRODUCTION THẬT) ---
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
JWT_ISSUER=school-management-api
JWT_AUDIENCE=school-management-web
PLATFORM_MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- CORS & Thiết bị ngoại vi ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost
ATTENDANCE_DUPLICATE_TOLERANCE_MS=120000
DEVICE_INGEST_API_KEY=replace-with-a-long-device-secret
BACKGROUND_REMINDERS_ENABLED=false

# ============================================================================
# TÍCH HỢP MÁY CHẤM CÔNG HIKVISION (ISAPI / WEBHOOK)
# Chú ý: TUYỆT ĐỐI KHÔNG cấu hình hoặc truy cập IP 192.168.1.22
# ============================================================================
TIMEKEEPING_SCHEDULER_ENABLED=false
HIKVISION_SYNC_ENABLED=false
HIKVISION_HOANANG_A_BASE_URL=https://192.168.1.8
HIKVISION_HOANANG_A_USERNAME=admin
HIKVISION_HOANANG_A_PASSWORD=replace-with-device-password
HIKVISION_HOANANG_A_ALLOW_SELF_SIGNED=true
HIKVISION_TIMEOUT_MS=5000
HIKVISION_RETRY_COUNT=1
TIMEKEEPING_WEBHOOK_TOKEN=
